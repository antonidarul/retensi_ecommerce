-- determining successful retention
SELECT
    order_status,
    COUNT(*) AS orders
FROM orders
GROUP BY order_status
ORDER BY orders DESC;

SELECT COUNT(*) AS successful_orders
FROM orders
WHERE order_status = 'Delivered';

--Customer purchase frequency

SELECT
    customer_id,
    COUNT(DISTINCT order_id) AS purchase_count
FROM orders
WHERE order_status = 'Delivered'
GROUP BY customer_id
ORDER BY purchase_count DESC;


-- Repeat successful customers

SELECT
    customer_id,
    COUNT(DISTINCT order_id) AS purchase_count
FROM orders
WHERE order_status = 'Delivered'
GROUP BY customer_id
HAVING COUNT(DISTINCT order_id) > 1
ORDER BY purchase_count DESC;

--First purchase
SELECT
    customer_id,
    MIN(order_date) AS first_purchase_date
FROM orders
WHERE order_status = 'Delivered'
GROUP BY customer_id;

SELECT
    customer_id,
    DATE_TRUNC('month', MIN(order_date)) AS cohort_month
FROM orders
WHERE order_status = 'Delivered'
GROUP BY customer_id
ORDER BY cohort_month, customer_id;

--purchase_month
SELECT
    customer_id,
    DATE_TRUNC('month', order_date) AS purchase_month
FROM orders
WHERE order_status = 'Delivered'
GROUP BY customer_id, DATE_TRUNC('month', order_date)
ORDER BY customer_id, purchase_month;

SELECT
    customer_id,
    COUNT(DISTINCT order_id) AS purchase_count
FROM orders
GROUP BY customer_id
HAVING COUNT(DISTINCT order_id) > 1
ORDER BY purchase_count DESC;

SELECT
    customer_id,
    order_id,
    order_status,
    order_date
FROM orders
WHERE customer_id IN (
    SELECT customer_id
    FROM orders
    GROUP BY customer_id
    HAVING COUNT(DISTINCT order_id) > 1
)
ORDER BY customer_id, order_date;

-- combine cohort_month and purchase month
WITH customer_cohort AS (
    SELECT
        customer_id,
        DATE_TRUNC('month', MIN(order_date)) AS cohort_month
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY customer_id
),

customer_activity AS (
    SELECT
        customer_id,
        DATE_TRUNC('month', order_date) AS purchase_month
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY customer_id, DATE_TRUNC('month', order_date)
)

SELECT
    c.customer_id,
    c.cohort_month,
    a.purchase_month
FROM customer_cohort c
JOIN customer_activity a
    ON c.customer_id = a.customer_id
ORDER BY c.customer_id, a.purchase_month;

-- count mount number 
WITH customer_cohort AS (
    SELECT
        customer_id,
        DATE_TRUNC('month', MIN(order_date)) AS cohort_month
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY customer_id
),

customer_activity AS (
    SELECT
        customer_id,
        DATE_TRUNC('month', order_date) AS purchase_month
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY customer_id, DATE_TRUNC('month', order_date)
),

cohort_activity AS (
    SELECT
        c.customer_id,
        c.cohort_month,
        a.purchase_month
    FROM customer_cohort c
    JOIN customer_activity a
        ON c.customer_id = a.customer_id
)

SELECT
    customer_id,
    cohort_month,
    purchase_month,
    (
        EXTRACT(YEAR FROM AGE(purchase_month, cohort_month)) * 12
        +
        EXTRACT(MONTH FROM AGE(purchase_month, cohort_month))
    ) AS month_number
FROM cohort_activity
ORDER BY cohort_month, customer_id, purchase_month;

