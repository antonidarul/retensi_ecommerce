ORDER BY month_number;

-- coupon -> repeat purchase rate
WITH customer_orders AS (
    SELECT
        customer_id,
        COUNT(DISTINCT order_id) AS purchase_count,
        BOOL_OR(coupon_code IS NOT NULL) AS used_coupon
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY customer_id
)

SELECT
    used_coupon,
    COUNT(*) AS customers,
    COUNT(*) FILTER (
        WHERE purchase_count > 1
    ) AS repeat_customers,
    ROUND(
        COUNT(*) FILTER (
            WHERE purchase_count > 1
        ) * 100.0 / COUNT(*),
        2
    ) AS repeat_purchase_rate
FROM customer_orders
GROUP BY used_coupon
ORDER BY used_coupon;

--referal source -> repeat purchase rate
WITH customer_orders AS (
    SELECT
        customer_id,
        COUNT(DISTINCT order_id) AS purchase_count,
        MAX(referral_source) AS referral_source
    FROM orders
    WHERE order_status = 'Delivered'
    GROUP BY customer_id
)

SELECT
    referral_source,
    COUNT(*) AS customers,
    COUNT(*) FILTER (
        WHERE purchase_count > 1
    ) AS repeat_customers,
    ROUND(
        COUNT(*) FILTER (
            WHERE purchase_count > 1
        ) * 100.0 / COUNT(*),
        2
    ) AS repeat_purchase_rate
FROM customer_orders
GROUP BY referral_source
ORDER BY repeat_purchase_rate DESC;

